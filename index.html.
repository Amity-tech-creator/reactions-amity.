
<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#091b16">
<title>Reactions Amity</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#091b16;color:#fff;font-family:Arial,sans-serif}
header{padding:20px;background:#102c22;color:#45e5a9;font-size:24px;font-weight:bold}
main{max-width:700px;margin:auto;padding:15px}
.card{background:#14291f;border:1px solid #28523e;border-radius:15px;padding:18px;margin:15px 0}
h2{color:#45e5a9}
input{width:100%;padding:13px;margin:8px 0;background:#091b16;color:white;border:1px solid #47765c;border-radius:8px}
button{background:#45e5a9;color:#092019;border:0;padding:12px 16px;border-radius:9px;font-weight:bold;margin:5px 3px}
.secondary{background:#29483a;color:white}
.hidden{display:none}
small{color:#a9c9b6}
.group{padding:12px 0;border-bottom:1px solid #31503d;display:flex;justify-content:space-between;align-items:center;gap:8px}
.status{color:#45e5a9}
</style>
</head>
<body>
<header>⚡ REACTIONS AMITY</header>
<main>
<div id="login" class="card">
<h2>🔐 Acesso privado</h2>
<p>Entra no teu painel.</p>
<input id="password" type="password" placeholder="Cria uma palavra-passe">
<button onclick="enter()">Entrar</button>
<p id="error"></p>
<small>Protótipo: o acesso é apenas local, não protege uma conta real.</small>
</div>

<div id="dashboard" class="hidden">
<div class="card">
<h2>📊 Painel principal</h2>
<p>Bem-vindo ao Reactions Amity!</p>
<p>WhatsApp: <span id="status" class="status">Desconectado</span></p>
<button onclick="connect()">Conectar (demo)</button>
<button class="secondary" onclick="logout()">Sair</button>
</div>

<div class="card">
<h2>👥 Gestão de grupos</h2>
<div id="groups">
<div class="group"><span>Família ❤️</span><button onclick="toggle(this)">Ativar bot</button></div>
<div class="group"><span>Amigos 🔥</span><button onclick="toggle(this)">Ativar bot</button></div>
</div>
<input id="newgroup" placeholder="Nome do grupo">
<button onclick="addGroup()">+ Adicionar grupo</button>
</div>

<div class="card">
<h2>❤️ Configuração de emojis</h2>
<input id="emojis" value="❤️ 😂 🔥 👍 😍">
<button onclick="saveEmojis()">Guardar emojis</button>
</div>

<div class="card">
<h2>🤖 Controlo dos bots</h2>
<p id="botstatus">Nenhum bot ativo.</p>
<button onclick="pauseAll()">Pausar todos</button>
</div>

<div class="card">
<h2>📈 Histórico</h2>
<p id="activity">Nenhuma atividade.</p>
</div>
<small>Versão demonstrativa. As ações ainda não controlam o WhatsApp real.</small>
</div>
</main>

<script>
function enter(){
let p=document.getElementById('password').value;
if(p.length<6){
document.getElementById('error').textContent='Usa pelo menos 6 caracteres.';
return;
}
document.getElementById('login').classList.add('hidden');
document.getElementById('dashboard').classList.remove('hidden');
}
function logout(){
document.getElementById('dashboard').classList.add('hidden');
document.getElementById('login').classList.remove('hidden');
document.getElementById('password').value='';
}
function connect(){
document.getElementById('status').textContent='Conexão simulada';
document.getElementById('activity').textContent='Conexão de demonstração iniciada.';
}
function toggle(b){
let active=b.textContent==='Ativar bot';
b.textContent=active?'Pausar bot':'Ativar bot';
document.getElementById('activity').textContent=active?'Bot ativado (demo).':'Bot pausado.';
updateBots();
}
function addGroup(){
let i=document.getElementById('newgroup');
let n=i.value.trim();
if(!n)return;
let d=document.createElement('div');
d.className='group';
let s=document.createElement('span');
s.textContent='👥 '+n;
let b=document.createElement('button');
b.textContent='Ativar bot';
b.onclick=function(){toggle(b)};
d.append(s,b);
document.getElementById('groups').append(d);
i.value='';
document.getElementById('activity').textContent='Grupo adicionado: '+n;
}
function saveEmojis(){
document.getElementById('activity').textContent='Emojis guardados: '+document.getElementById('emojis').value;
}
function pauseAll(){
document.querySelectorAll('.group button').forEach(b=>b.textContent='Ativar bot');
document.getElementById('activity').textContent='Todos os bots foram pausados.';
updateBots();
}
function updateBots(){
let count=[...document.querySelectorAll('.group button')].filter(b=>b.textContent==='Pausar bot').length;
document.getElementById('botstatus').textContent=count+' bot(s) ativo(s) em modo demonstração.';
}
</script>
</body>
</html>
