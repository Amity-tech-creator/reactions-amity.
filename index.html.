
<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Reactions Amity</title>
<style>
body{margin:0;background:#0b1512;color:white;font-family:Arial,sans-serif;padding:18px}
header{color:#43e5ad;font-size:25px;font-weight:bold;margin:20px 0}
.card{background:#172720;padding:18px;border-radius:15px;margin:15px 0;border:1px solid #315347}
input{box-sizing:border-box;width:100%;padding:13px;margin:8px 0;background:#0b1512;color:white;border:1px solid #456657;border-radius:8px}
button{background:#43e5ad;color:#092019;border:0;padding:12px;border-radius:9px;font-weight:bold;margin:5px 3px}
button.secondary{background:#30463c;color:white}
.hidden{display:none}
small{color:#a8c5b7}
</style>
</head>
<body>
<header>⚡ Reactions Amity</header>

<div id="login" class="card">
<h2>Acesso privado</h2>
<p>Cria a tua palavra-passe inicial.</p>
<input id="password" type="password" placeholder="Palavra-passe">
<button onclick="enter()">Entrar</button>
<p id="error"></p>
<small>Protótipo: este acesso é apenas local, não é autenticação segura.</small>
</div>

<div id="app" class="hidden">
<div class="card">
<h2>Bem-vindo ao painel!</h2>
<p>Controla os teus grupos e configurações.</p>
<p>Estado: <b id="status">Desconectado</b></p>
<button onclick="connect()">Conectar (demonstração)</button>
<button class="secondary" onclick="logout()">Sair</button>
</div>

<div class="card">
<h2>👥 Grupos</h2>
<div id="groups">
<p>Família <button onclick="toggle(this)">Ativar bot</button></p>
<p>Amigos <button onclick="toggle(this)">Ativar bot</button></p>
</div>
<input id="newgroup" placeholder="Nome do novo grupo">
<button onclick="addGroup()">Adicionar grupo</button>
</div>

<div class="card">
<h2>❤️ Reações</h2>
<input id="emojis" value="❤️ 😂 🔥 👍 😍">
<button onclick="save()">Guardar emojis</button>
</div>

<div class="card">
<h2>📊 Atividade</h2>
<p id="activity">Nenhuma atividade.</p>
</div>
<small>Versão demonstrativa. Ainda não envia reações ao WhatsApp real.</small>
</div>

<script>
function enter(){
let p=document.getElementById('password').value;
if(p.length<6){document.getElementById('error').textContent='Usa pelo menos 6 caracteres.';return;}
document.getElementById('login').classList.add('hidden');
document.getElementById('app').classList.remove('hidden');
}
function logout(){
document.getElementById('app').classList.add('hidden');
document.getElementById('login').classList.remove('hidden');
document.getElementById('password').value='';
}
function connect(){
document.getElementById('status').textContent='Conectado (demo)';
document.getElementById('activity').textContent='Conexão simulada iniciada.';
}
function toggle(b){
let on=b.textContent==='Ativar bot';
b.textContent=on?'Pausar bot':'Ativar bot';
document.getElementById('activity').textContent=on?'Bot ativado (simulação).':'Bot pausado.';
}
function addGroup(){
let i=document.getElementById('newgroup'),n=i.value.trim();
if(!n)return;
let p=document.createElement('p');
p.textContent=n+' ';
let b=document.createElement('button');
b.textContent='Ativar bot';
b.onclick=function(){toggle(b)};
p.appendChild(b);
document.getElementById('groups').appendChild(p);
i.value='';
}
function save(){
document.getElementById('activity').textContent='Emojis guardados: '+document.getElementById('emojis').value;
}
</script>
</body>
</html>
